  "keywords": [
    "imap",
    "email",
    "images",
    "download",
    "backend"
  ],
  "files": {
    "include": [
      "plugin.py",
      "plugin.json"
    ],
    "exclude": [
      "*.md",
      "tests/**",
      "__pycache__/**"
    ]
  },
  "requirements": {
    "config_required": true
  }
}
