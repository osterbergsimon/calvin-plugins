{
  "api_version": 1,
  "id": "system_monitor",
  "name": "System Monitor",
  "version": "2.0.0",
  "type": "service",
  "description": "Live system metrics — CPU, memory, disk, temperature and network. Optimised for Raspberry Pi.",
  "author": "Calvin Team",
  "license": "MIT",
  "homepage": "https://github.com/calvin-dashboard/calvin-plugins",
  "repository": "https://github.com/calvin-dashboard/calvin-plugins",
  "keywords": [
    "service",
    "system",
    "monitor",
    "cpu",
    "memory",
    "raspberry-pi"
  ],
  "dependencies": {
    "packages": [
      "psutil>=5.9"
    ]
  },
  "files": {
    "include": [
      "plugin.py",
      "plugin.json"
    ],
    "exclude": [
      "*.md",
      "tests/**",
      "__pycache__/**"
    ]
  },
  "requirements": {
    "config_required": false
  }
}
